# =============================================================================
# TestPsico — development environment variables (F1)
#
# ALL VALUES BELOW ARE SAFE, DEV-ONLY DEFAULTS.
# They let a fresh clone boot with `docker compose up -d --build` and nothing
# else. They are NOT secrets: they are published in the repository on purpose.
#
# For real use:
#   1. Run `scripts/init-env` (or `cp .env.example .env`) to create `.env`
#   2. Override every password/secret below with a strong random value
#   3. NEVER commit `.env` (it is gitignored)
#
# App configuration uses the PSICO_* prefix; infrastructure uses POSTGRES_*
# and REDIS_*. `app/core/config.py` (pydantic-settings) mirrors these exact
# defaults so container and host never drift.
# =============================================================================

# --- App environment ---------------------------------------------------------
# dev | prod. F1 only ships `dev`.
PSICO_ENV=dev

# Authentication mode. F1 value: dev (seeded accounts + HS256 JWT). Future
# phases may add an OIDC provider behind this same seam.
PSICO_AUTH_MODE=dev

# DEV-ONLY JWT signing secret. Change this in your local .env.
PSICO_JWT_SECRET=psico-dev-jwt-secret-change-me

# DEV-ONLY passwords for the three seeded dev accounts (admin / psicologo /
# evaluado). The seed hashes these with PBKDF2 before storing them.
PSICO_DEV_PASSWORD_ADMIN=psico-dev-admin
PSICO_DEV_PASSWORD_PSICOLOGO=psico-dev-psicologo
PSICO_DEV_PASSWORD_EVALUADO=psico-dev-evaluado

# SQLAlchemy database URL. `db` is the compose service name; psico_app is the
# dev superuser role created by the db container (POSTGRES_USER below).
PSICO_DATABASE_URL=postgresql+psycopg://psico_app:psico_dev_password@db:5432/psico

# Redis URL (reserved; not used by F1 business logic).
PSICO_REDIS_URL=redis://redis:6379/0

# Audit retention (days). F1 keeps everything; used by future purge jobs.
PSICO_AUDIT_RETENTION_DAYS=365

# Log level: DEBUG | INFO | WARNING | ERROR
PSICO_LOG_LEVEL=INFO

# --- Infrastructure (consumed by docker-compose.yml) -------------------------
# The role/database created by the db container. In dev this role is also the
# API connection user; the append-only audit trigger still enforces UPDATE/DELETE
# rejection regardless of role.
POSTGRES_USER=psico_app
POSTGRES_PASSWORD=psico_dev_password
POSTGRES_DB=psico
POSTGRES_PORT=5432

REDIS_PORT=6379
API_PORT=8000
